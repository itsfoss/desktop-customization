            emphasis_1 166 227 161
            emphasis_2 137 180 250
            emphasis_3 245 194 231
        }
        exit_code_success {
            base 166 227 161
            background 30 30 46
            emphasis_0 166 227 161
            emphasis_1 166 227 161
            emphasis_2 166 227 161
            emphasis_3 166 227 161
        }
        exit_code_error {
            base 243 139 168
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 243 139 168
            emphasis_2 243 139 168
            emphasis_3 243 139 168
        }
        multiplayer_user_colors {
            player_1 180 190 254
            player_2 148 226 213
            player_3 166 227 161
            player_4 249 226 175
            player_5 245 194 231
            player_6 243 139 168
            player_7 137 180 250
