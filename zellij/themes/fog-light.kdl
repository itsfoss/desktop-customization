// Fog — Zellij theme (pastel light)
// Matches fog-light Alacritty theme

themes {
    fog-light {
        text_unselected {
            base 54 66 88         // foreground #364258
            background 242 245 249 // background #f2f5f9
            emphasis_0 184 104 120 // red #b86878
            emphasis_1 90 152 136  // green #5a9888
            emphasis_2 88 128 184  // blue #5880b8
            emphasis_3 136 112 176 // magenta #8870b0
        }
